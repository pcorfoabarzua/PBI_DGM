	measure 'Titulo Req Viajes' = ```
			
			VAR ProyectoCod =
			    SELECTEDVALUE (
			        PB_VIAJE_MUESTREO_TEST[PROYECTO],
			        "MULTI"
			    )
			
			VAR ProyectoNombre =
			    SWITCH (
			        ProyectoCod,
			        "PCS", "Pelágico Centro Sur",
			        "PN",  "Pelágico Norte",
			        "DAP",  "Aguas Profundas",
			        "C",  "Crustáceos",
			        "CB" , "Crustáceos Bentónicos" ,
			        "DES" , "Descarte Demersales" ,
			        "DES_CER" , "Descarte Pelágico" ,
			        "MULTI", "Múltiples proyectos",
			        ProyectoCod        -- fallback por si aparece uno nuevo
			    )
			
			VAR CumplimientoTxt =
			    FORMAT ( [% Cumplimiento General Viajes], "0.0%" )
			
			VAR Estrellas =
			    [Estrellas Cumplimiento Viajes]
			
			RETURN
			IF (
			    ISBLANK ( [% Cumplimiento General Viajes] ),
			    ProyectoNombre & " - Viajes (sin requerimiento definido)",
			    ProyectoNombre
			        & " - Cumplimiento General Viajes: "
			        & CumplimientoTxt
			        & " "
			        & Estrellas
			)
			
			```
		lineageTag: f37fdb70-0457-4f08-b4ca-7738edd17d60

	measure 'Estrellas Cumplimiento Viajes' =
			
			VAR Cumplimiento =
			    [% Cumplimiento General Viajes]
			RETURN
			SWITCH (
			    TRUE(),
			    ISBLANK ( Cumplimiento ), "",
			    Cumplimiento <= 0.30, "⭐",
			    Cumplimiento <= 0.70, "⭐⭐",
			    "⭐⭐⭐"
			)
		lineageTag: 3b18b49f-b3ec-46d2-b5c5-4394388ca731

