			        ABS(
			            DATEDIFF(
			                PB_VIAJE_MUESTREO_TEST[FECHA_HORA_ZARPE],
			                PB_VIAJE_MUESTREO_TEST[FECHA_HORA_RECALADA],
			                HOUR
			            )
			        )
			    )
			
			)
			
			
			```
