		lineageTag: 1a983f86-9b7e-4b0c-bc06-ae818a2fbbb7

	measure 'Req Longitud' = ```
			
			
			 VAR LugarNorm =
			    LOWER(
			        TRIM(
			            SELECTEDVALUE( PB_VIAJE_MUESTREO_TEST[LUGAR_MUESTREO], "embarcado" )
