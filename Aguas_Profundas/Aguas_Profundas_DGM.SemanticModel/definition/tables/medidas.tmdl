	measure 'Req (según actividad)' = ```
			
			VAR Act = SELECTEDVALUE ( 'Dimension ACTIVIDAD'[CODIGO_ACTIVIDAD] )
			VAR ReqOto = [Req Otolitos]
			VAR ReqLon = [Req Longitud]
			VAR ReqBio = [Req Biológico]
			RETURN
			IF (
			    NOT ISBLANK ( Act ),
			    SWITCH ( Act, 4, ReqOto, 2, ReqLon, 3, ReqBio, BLANK() ),
			    -- Si no hay una sola actividad en el contexto (totales), muestra la suma total:
			    ReqOto + ReqLon + ReqBio
			)
			
			
			```
		formatString: #,0
		lineageTag: 7099ad9a-e27d-4de9-b662-632e08144d4b

