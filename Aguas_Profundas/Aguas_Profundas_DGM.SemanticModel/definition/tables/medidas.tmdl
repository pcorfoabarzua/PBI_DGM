	measure 'Color N° Viajes Año Pasado' = ```
			
			VAR Actual = [Viajes totales]
			VAR Anterior = [N° Viajes Año Pasado Tarjeta] 
			-- Colores (puedes cambiarlos por tu paleta corporativa)
			VAR Verde = "#2E7D32"   -- verde oscuro
			VAR Rojo  = "#C62828"   -- rojo
			VAR Gris  = "#9E9E9E"   -- opcional para casos sin dato
			RETURN
			SWITCH (
			    TRUE(),
			    ISBLANK(Anterior) || ISBLANK(Actual), Gris,          -- evita color “falso” si falta dato
			    Anterior <= Actual, Verde,
			    Rojo
			)
			
			```
		lineageTag: bd757377-bcb3-4e90-8be8-fdfff0baeb23

