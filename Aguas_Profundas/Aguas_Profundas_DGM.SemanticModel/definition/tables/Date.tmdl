		sourceColumn: [Date]

		variation Variación
			isDefault
			relationship: 909e0101-7270-4e32-a44d-003a9b728bdc
			defaultHierarchy: LocalDateTable_75d9bd68-b8f0-4024-bf16-17cc1d9d78ba.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column PERIODOMES = ```
			YEAR('Date'[Date]) & MONTH('Date'[Date]) 
			```
		lineageTag: cbf4f299-aa97-4290-83d5-c642baaa4ac5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Year
		formatString: 0
		lineageTag: 85f28d6b-e300-4e05-9767-21cebb77d6b1
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = Automatic

	column 'Month Number'
		formatString: 0
		lineageTag: 6d10d0b6-3ce1-4bd9-a0bb-53ee600bc400
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Month Number]

		annotation SummarizationSetBy = Automatic

	column 'Month Year'
		lineageTag: 3cfdbf60-68f7-4d16-96bc-354c188c962a
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Year]

		annotation SummarizationSetBy = Automatic

	column Mes
		lineageTag: d12c2652-ddac-4ebd-9b6a-361764cf1ba4
		summarizeBy: none
		isNameInferred
		sourceColumn: [Mes]
		sortByColumn: 'Month Number'

		annotation SummarizationSetBy = Automatic

	partition Date = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDAR (
				        MIN ( PB_VIAJE_MUESTREO_TEST[FECHA] ),
				        MAX ( PB_VIAJE_MUESTREO_TEST[FECHA] )
				    ),
				    "Year", YEAR ( [Date] ),
				    "Month Number", MONTH ( [Date] ),
				    "Mes" ,
				    SWITCH (
				    MONTH ( [Date] ),
				    1, "enero",
				    2, "febrero",
				    3, "marzo",
				    4, "abril",
				    5, "mayo",
				    6, "junio",
				    7, "julio",
				    8, "agosto",
				    9, "septiembre",
				    10, "octubre",
				    11, "noviembre",
				    12, "diciembre"
				),  -- Se coloco este Switch debido a que la configuracion regional original esta en inglés y no podia cambiar el formato de Mes en texto a español
				    "Month Year", FORMAT ( [Date], "[$-es-ES]MMM yyyy" )
				)

	annotation PBI_Id = 159e75b837834a2b94f7680f44ece2a8

