		sourceColumn: [PeriodoTexto]

		annotation SummarizationSetBy = Automatic

	partition 'Dimension PERIODO' = calculated
		mode: import
		source = ```
				
				VAR MinDate =
				    CALCULATE ( MIN ( 'Date'[Date] ), ALL ( 'Date' ) )
				VAR MaxDate =
				    CALCULATE ( MAX ( 'Date'[Date] ), ALL ( 'Date' ) )
				VAR Base =
				    ADDCOLUMNS (
				        CALENDAR ( EOMONTH ( MinDate, -1 ) + 1, EOMONTH ( MaxDate, 0 ) ),
				        "Año", YEAR ( [Date] ),
				        "MesN", MONTH ( [Date] ),
				        "MesTxt", FORMAT ( [Date], "[$-es-CL]mmm" ),
				        "PERIODOMES", FORMAT ( [Date], "yyyyMM" ),
				        "InicioMes", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 ),
				        "FinMes", EOMONTH ( [Date], 0 ),
				        "Trimestre", "T" & FORMAT ( [Date], "Q" ),
				        "PeriodoTexto", FORMAT ( [Date], "[$-es-CL]mmm-yyyy" )
				    )
				RETURN
				    SUMMARIZE (
				        Base,
				        [Año], [MesN], [MesTxt], [PERIODOMES], [InicioMes], [FinMes], [Trimestre], [PeriodoTexto]
				    )
				
				```

