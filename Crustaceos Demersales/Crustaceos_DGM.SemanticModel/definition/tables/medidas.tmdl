	measure 'Req Viajes' = ```
			
			VAR LugarNorm =
			    LOWER ( TRIM ( SELECTEDVALUE ( PB_VIAJE_MUESTREO_TEST[LUGAR_MUESTREO], BLANK() ) ) )
			
			VAR ReqViajes_Embarcados =
			    CALCULATE (
			        SUM ( 'PB_REQ_VIAJES'[TOT_VIAJE_EMB] ),
			        TREATAS ( VALUES ( 'Date'[PERIODOMES] ), 'PB_REQ_VIAJES'[PERIODOMES] )
			  
			    )
			
			VAR ReqViajes_Tierra =
			    CALCULATE (
			        SUM ( 'PB_REQ_VIAJES'[TOT_VIAJE_ENC] ),
			        TREATAS ( VALUES ( 'Date'[PERIODOMES] ), 'PB_REQ_VIAJES'[PERIODOMES] )
			
			    )
			
			-- Medida que ya usas
			VAR NumViajes = [Viajes totales]
			RETURN
			IF (
			    ISBLANK ( NumViajes ),
			    0,
			    SWITCH (
			        TRUE (),
			        LugarNorm = "embarcado", ReqViajes_Embarcados,
			        LugarNorm = "tierra" || LugarNorm = "encuesta en tierra", ReqViajes_Tierra,
			        -- Si no hay un único LUGAR_MUESTREO, conserva default si lo necesitas (o BLANK())
			        ReqViajes_Embarcados
			    )
			)
			
			```
		formatString: #,0
		lineageTag: bb07a41a-3149-45fa-820f-2c680a3e03b5

	measure 'Color N° Viajes Año Pasado' = ```
			
			VAR Actual = [Viajes Totales Tarjeta]
			VAR Anterior = [N° Viajes Año pasado]
			-- Colores (puedes cambiarlos por tu paleta corporativa)
			VAR Verde = "#2E7D32"   -- verde oscuro
			VAR Rojo  = "#C62828"   -- rojo
			VAR Gris  = "#9E9E9E"   -- opcional para casos sin dato
			
			VAR Resultado = IF(ISBLANK(Anterior) , 0 , Anterior)
			
			
			
			RETURN
			SWITCH (
			    TRUE(),
			    ISBLANK(Resultado) || ISBLANK(Actual), Gris,          -- evita color “falso” si falta dato
			    Anterior <= Actual, Verde,
			    Rojo
			)
			
			```
		lineageTag: 79bc53b2-92e8-45a1-bb44-a61c9ab4b60b

