	measure 'Req (según actividad — solo PERIODO_MES)' = ```
			
			VAR Act = SELECTEDVALUE ( 'Dimension ACTIVIDAD'[CODIGO_ACTIVIDAD] )
			RETURN
			SWITCH(
			   TRUE(),
			   ISINSCOPE('Dimension ACTIVIDAD'[CODIGO_ACTIVIDAD]),
			      SWITCH( Act,
			              4, [Req Otolitos],
			              2, [Req Longitud],
			              3, [Req Biológico],
			              BLANK()
			      ),
			   [Req Total — solo PERIODO_MES]    -- totales sin actividad
			)
			
			```
