			VAR Req_oto_tierra =
			CALCULATE(
			    SUM('PB_REQ_MUESTREO'[TOT_MUES_CON_OTOL]),
			    KEEPFILTERS(
			        TREATAS(
			            VALUES('Date'[PERIODOMES]),
			            'PB_REQ_MUESTREO'[PERIODOMES]
			        )
			    ) , FILTER(PB_REQ_MUESTREO , PB_REQ_MUESTREO[LUGAR_MUESTREO] = "TIERRA")
			)
			 
			VAR Req_oto_emb = CALCULATE(
			    SUM('PB_REQ_MUESTREO'[TOT_MUES_CON_OTOL]),
