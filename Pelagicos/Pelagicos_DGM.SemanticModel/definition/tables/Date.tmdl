		sortByColumn: 'Month Number'

		annotation SummarizationSetBy = Automatic

	partition Date = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS (
				    CALENDAR (
				        MIN ( PB_VIAJE_MUESTREO_TEST[FECHA] ),
				        MAX ( PB_VIAJE_MUESTREO_TEST[FECHA] )
				    ),
				    "Year", YEAR ( [Date] ),
				    "Month Number", MONTH ( [Date] ),
				    "Mes" ,
				    SWITCH (
				    MONTH ( [Date] ),
				    1, "enero",
				    2, "febrero",
				    3, "marzo",
				    4, "abril",
				    5, "mayo",
				    6, "junio",
				    7, "julio",
				    8, "agosto",
				    9, "septiembre",
				    10, "octubre",
				    11, "noviembre",
				    12, "diciembre"
				),
				    "Month Year", FORMAT ( [Date], "[$-es-ES]MMM yyyy" )   -- <- en español
				)
				
				```

	annotation PBI_Id = 159e75b837834a2b94f7680f44ece2a8

