	measure 'N° Viajes Embarcados' = ```
			
			
			/*   
			    Calculo del N° Viajes que son Bitacora y que sean Embarcados
			
			    Para el caso de 2021 , Region Bio Bio , Mes 12 ,   Flota Industrial : Se obtienen 9 Viajes en esta medida y en el gráfico se obtienen 10 Viajes debido a que hay dos Viajes donde lo único que cambia es la Zona
			
			
			*/
			 
			    COUNTROWS(
			        SUMMARIZE(
			            PB_VIAJE_MUESTREO_TEST , 
			            PB_VIAJE_MUESTREO_TEST[COD_BARCO],
			            PB_VIAJE_MUESTREO_TEST[FECHA_HORA_RECALADA]
			        )
			    )
			
			
			
			```
		formatString: 0
		lineageTag: 7590d973-40f5-4e25-8e68-079d4aec3c39

