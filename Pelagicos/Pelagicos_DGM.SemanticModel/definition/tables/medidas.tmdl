		formatString: 0
		lineageTag: 7e7f74f9-b8f4-4f20-a143-7f514f229967

	measure 'Req Longitud' = ```
			
			
			 VAR LugarNorm =
			    LOWER(
			        TRIM(
			            SELECTEDVALUE( PB_VIAJE_MUESTREO_TEST[LUGAR_MUESTREO], "embarcado" )
