	measure 'Req (según actividad)' = ```
			
			VAR Act = SELECTEDVALUE ( 'Dimension ACTIVIDAD'[CODIGO_ACTIVIDAD] )
			VAR ReqOto = [Req Otolitos]
			VAR ReqLon = [Req Longitud]
			VAR ReqBio = [Req Biológico]
			RETURN
			IF (
			    NOT ISBLANK ( Act ),
			    SWITCH ( Act, 4, ReqOto, 2, ReqLon, 3, ReqBio, BLANK() ),
			    -- Si no hay una sola actividad en el contexto (totales), muestra la suma total:
			    ReqOto + ReqLon + ReqBio
			)
			
			```
		formatString: 0
		lineageTag: ec9dd188-4756-4199-be3a-872a932ef003

	measure 'Req (forzado por PROYECTO y PERIODO)' = ```
			
			VAR ProySel = VALUES ( 'Dimension PROYECTO'[COD_PROYECTO] )
			VAR PerSel  = VALUES ( 'Dimension PERIODO'[PERIODOMES] )
			RETURN
			CALCULATE (
			    SUM ( 'PB_REQ_MUESTREO'[TOT_MUES_BIO] ) 
			      + SUM ( 'PB_REQ_MUESTREO'[TOT_MUES_LON] )
			      + SUM ( 'PB_REQ_MUESTREO'[TOT_MUES_CON_OTOL] ),
			    TREATAS ( ProySel, 'PB_REQ_MUESTREO'[COD_PROYECTO] ),
			    TREATAS ( PerSel,  'PB_REQ_MUESTREO'[PERIODOMES] )
			)
			
			```
		formatString: 0
		lineageTag: 7b02f247-6ed7-4751-a8d4-e70e92b7bd9f

	measure 'Datos Periodo Mes' = ```
			
			VAR periodoMesSel =
			    FILTER(
			        VALUES('Dimension PERIODO'[PERIODOMES]),
			        NOT ISBLANK('Dimension PERIODO'[PERIODOMES])
			    )
			VAR data =
			    CALCULATETABLE(
			        VALUES('Date'[PERIODOMES]),
			        TREATAS(periodoMesSel, 'Date'[PERIODOMES])
			    )
			RETURN
			IF( NOT ISEMPTY(data), 1, BLANK() )
			
			```
		formatString: 0
		lineageTag: 60c608a4-3e83-4b18-9431-f9c80a0bc462

