			        )
			    ) , FILTER(PB_REQ_MUESTREO , PB_REQ_MUESTREO[LUGAR_MUESTREO] = "EMBARCADO")
			)
			 
			 
			VAR Resultado =
			    SWITCH(
			        TRUE(),
			        LugarNorm = "embarcado", Req_oto_emb,
			        LugarNorm = "tierra" || LugarNorm = "encuesta en tierra", Req_oto_tierra,
			        -- default si el LUGAR no está definido
			        Req_oto_tierra + Req_oto_emb
