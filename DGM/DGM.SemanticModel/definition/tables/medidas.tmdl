	measure 'Titulo Req Viajes' = ```
			
			VAR ProyectoCod =
			    SELECTEDVALUE (
			        PB_VIAJE_MUESTREO_TEST[PROYECTO],
			        "MULTI"
			    )
			
			VAR ProyectoNombre =
			    SWITCH (
			        ProyectoCod,
			        "PCS", "Pelágico Centro Sur",
			        "PN",  "Pelágico Norte",
			        "DAP",  "Aguas Profundas",
			        "C",  "Crustáceos Demersales",
			        "CB" , "Crustáceos Bentónicos" ,
			        "DES" , "Descarte Demersales" ,
			        "DES_CER" , "Descarte Pelágico" ,
			        "B" , "Bentónicos" , 
			        "MULTI", "Múltiples proyectos",
			        ProyectoCod        -- fallback por si aparece uno nuevo
			    )
			
			VAR CumplimientoTxt =
			    FORMAT ( [% Cumplimiento General Viajes], "0.0%" )
			
			VAR Estrellas =
			    [Estrellas Cumplimiento Viajes]
			
			RETURN
			IF (
			    ISBLANK ( [% Cumplimiento General Viajes] ),
			    ProyectoNombre & " - Viajes (sin requerimiento definido)",
			    ProyectoNombre
			        & " - Cumplimiento General Viajes: "
			        & CumplimientoTxt
			        & " "
			        & Estrellas
			)
			
			
			```
		lineageTag: 3b87a5b4-8d28-471b-9fa7-b2bc011cfdb6

