	measure 'Req Total — solo PERIODO_MES' = ```
			
			[Req Biológico] +
			[Req Longitud] +
			[Req Otolitos]
			
			```
		formatString: 0
		lineageTag: 13e1d47d-08df-49e2-8c0c-e93768bae87c

	measure 'Req (según actividad — solo PERIODO_MES)' = ```
			
			VAR Act = SELECTEDVALUE ( 'Dimension ACTIVIDAD'[CODIGO_ACTIVIDAD] )
			RETURN
			SWITCH(
			   TRUE(),
			   ISINSCOPE('Dimension ACTIVIDAD'[CODIGO_ACTIVIDAD]),
			      SWITCH( Act,
			              4, [Req Otolitos],
			              2, [Req Longitud],
			              3, [Req Biológico],
			              BLANK()
			      ),
			   [Req Total — solo PERIODO_MES]    -- totales sin actividad
			)
			
			```
		formatString: 0
		lineageTag: 2b1530dd-6cec-40ab-bd1f-063b15d34e11

	measure '% Cumplimiento muestreos' = ```
			
			DIVIDE ( [nmuestras2], [Req (según actividad)] )
			
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: c125eec5-01e3-4eb5-99ba-10708d1ed1df

	measure 'Req Viajes' = ```
			
			VAR LugarNorm =
			    LOWER ( TRIM ( SELECTEDVALUE ( PB_VIAJE_MUESTREO_TEST[LUGAR_MUESTREO], BLANK() ) ) )
			
			VAR ReqViajes_Embarcados =
			    CALCULATE (
			        SUM ( 'PB_REQ_VIAJES'[TOT_VIAJE_EMB] ),
			        TREATAS ( VALUES ( 'Date'[PERIODOMES] ), 'PB_REQ_VIAJES'[PERIODOMES] )
			    )
			
			VAR ReqViajes_Tierra =
			    CALCULATE (
			        SUM ( 'PB_REQ_VIAJES'[TOT_VIAJE_ENC] ),
			        TREATAS ( VALUES ( 'Date'[PERIODOMES] ), 'PB_REQ_VIAJES'[PERIODOMES] )
			    )
			
			-- Medida que ya usas
			VAR NumViajes = [Viajes totales]
			RETURN
			IF (
			    ISBLANK ( NumViajes ),
			    BLANK (),
			    SWITCH (
			        TRUE (),
			        LugarNorm = "embarcado", ReqViajes_Embarcados,
			        LugarNorm = "tierra" || LugarNorm = "encuesta en tierra", ReqViajes_Tierra,
			        -- Si no hay un único LUGAR_MUESTREO, conserva default si lo necesitas (o BLANK())
			        ReqViajes_Embarcados
			    )
			)
			
			
			```
		formatString: 0
		lineageTag: 5ec2af2e-9fb9-42a2-9c85-cc64657d2867

	measure 'Cumplimiento viaje' = ```
			
			VAR Viajes =
			    [Viajes totales]
			
			VAR Req =
			    [Req Viajes]
			
			RETURN
			IF (
			    NOT [Req Viajes Existe],
			    BLANK (),
			    DIVIDE ( Viajes, Req )
			)
			
			
			
			```
		lineageTag: c85b6c01-2f3b-49c0-87af-0e839f24da1e

	measure 'Viajes totales (Bitácora)' = ```
			
			CALCULATE(
			    COUNTROWS(
			        SUMMARIZE(
			            PB_VIAJE_MUESTREO_TEST,
			            PB_VIAJE_MUESTREO_TEST[COD_BARCO],
			            PB_VIAJE_MUESTREO_TEST[FECHA]
			        )
			    ),
			    PB_VIAJE_MUESTREO_TEST[CODIGO_ACTIVIDAD] = 40
			)
			
