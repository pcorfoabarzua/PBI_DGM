	measure 'Req Biológico' = ```
			
			
			 VAR LugarNorm =
			    LOWER(
			        TRIM(
			            SELECTEDVALUE( PB_VIAJE_MUESTREO_TEST[LUGAR_MUESTREO], "embarcado" )
			        )
			    )
			 
			VAR Req_bio_tierra =
			CALCULATE(
			    SUM('PB_REQ_MUESTREO'[TOT_MUES_BIO]),
			    KEEPFILTERS(
			        TREATAS(
			            VALUES('Date'[PERIODOMES]),
			            'PB_REQ_MUESTREO'[PERIODOMES]
			        )
			    ) , FILTER(PB_REQ_MUESTREO , PB_REQ_MUESTREO[LUGAR_MUESTREO] = "TIERRA" || ISBLANK(PB_REQ_MUESTREO[LUGAR_MUESTREO]))
			)
			 
			VAR Req_bio_emb = CALCULATE(
			    SUM('PB_REQ_MUESTREO'[TOT_MUES_BIO]),
			    KEEPFILTERS(
			        TREATAS(
			            VALUES('Date'[PERIODOMES]),
			            'PB_REQ_MUESTREO'[PERIODOMES]
			        )
			    ) , FILTER(PB_REQ_MUESTREO , PB_REQ_MUESTREO[LUGAR_MUESTREO] = "EMBARCADO" || ISBLANK(PB_REQ_MUESTREO[LUGAR_MUESTREO]))
			)
			 
			 
			VAR Resultado =
			    SWITCH(
			        TRUE(),
			        LugarNorm = "embarcado", Req_bio_emb,
			        LugarNorm = "tierra" || LugarNorm = "encuesta en tierra", Req_bio_tierra,
			        -- default si el LUGAR no está definido
			        Req_bio_tierra + Req_bio_emb
			    )
			RETURN
			Resultado
			
			
			
			```
		formatString: 0
		lineageTag: 09bba311-b38e-4eb4-90cf-68dfe3815e97

	measure 'Req Otolitos' = ```
			
			
			VAR LugarNorm =
