	measure 'Req Viajes (Pesqueria)' = ```
			
			VAR LugarNorm =
			    LOWER(
			        TRIM(
			            SELECTEDVALUE(
			                PB_VIAJE_MUESTREO_TEST[LUGAR_MUESTREO],
			                "embarcado"
			            )
			        )
			    )
			
			-- ✅ Evalúa existencia de región SIN filtro de región
			
			VAR TieneRegion =
			    CALCULATE(
			        COUNTROWS('PB_REQ_VIAJES'),
			        NOT ISBLANK('PB_REQ_VIAJES'[COD_REGION]),
			
			        -- ✅ mantener período
			        TREATAS(
			            VALUES('Date'[PERIODOMES]),
			            'PB_REQ_VIAJES'[PERIODOMES]
			        ),
			
			        -- ❌ eliminar sesgos de dimensiones operativas
			        REMOVEFILTERS('Dimension REGION'),
			        REMOVEFILTERS('Dimension FLOTA')
			    ) > 0
			
			
			-- ✅ EMBARCADO
			VAR ReqViajes_Emb =
			    IF(
			        TieneRegion,
			        CALCULATE(
			            SUM('PB_REQ_VIAJES'[TOT_VIAJE_EMB]),
			            TREATAS(VALUES('Date'[PERIODOMES]), 'PB_REQ_VIAJES'[PERIODOMES]),
			
			            TREATAS(
			                VALUES('Dimension REGION'[COD_REGION]),
			                'PB_REQ_VIAJES'[COD_REGION]
			            )
			
			        ),
			        CALCULATE(
			            SUM('PB_REQ_VIAJES'[TOT_VIAJE_EMB]),
			            TREATAS(VALUES('Date'[PERIODOMES]), 'PB_REQ_VIAJES'[PERIODOMES]),
			
			            REMOVEFILTERS('Dimension REGION'),
			            REMOVEFILTERS('Dimension FLOTA')
			        )
			    )
			
			-- ✅ TIERRA
			VAR ReqViajes_Tie =
			    IF(
			        TieneRegion,
			        CALCULATE(
			            SUM('PB_REQ_VIAJES'[TOT_VIAJE_ENC]),
			            TREATAS(VALUES('Date'[PERIODOMES]), 'PB_REQ_VIAJES'[PERIODOMES]),
			
			            TREATAS(
			                VALUES('Dimension REGION'[COD_REGION]),
			                'PB_REQ_VIAJES'[COD_REGION]
			            )
			
			        ),
			        CALCULATE(
			            SUM('PB_REQ_VIAJES'[TOT_VIAJE_ENC]),
			            TREATAS(VALUES('Date'[PERIODOMES]), 'PB_REQ_VIAJES'[PERIODOMES]),
			
			            REMOVEFILTERS('Dimension REGION'),
			            REMOVEFILTERS('Dimension FLOTA')
			        )
			    )
			
			RETURN
			SWITCH(
			    TRUE(),
			    LugarNorm = "embarcado", ReqViajes_Emb,
			    LugarNorm = "tierra" || LugarNorm = "encuesta en tierra", ReqViajes_Tie,
			    ReqViajes_Emb
			)
			
			
			```
		formatString: 0
		lineageTag: 3a1c29a9-2144-4f5a-b87f-03b12f09594f

