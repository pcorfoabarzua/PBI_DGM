	measure 'N° Muestreos test' = ```
			
			
			/*  
			    Esto realiza una suma de NRO_MUESTREOS_ESPECIE con las siguientes condiciones
			
			    1.Que la ACTIVIDAD sea MUESTREO BIOLOGICO , MUESTREO LONGITUD Y PROPORCION ESPECIES
			
			    2.Que el lugar de muestreo sea EMBARCADO
			    
			
			*/
			
			CALCULATE(
			    SUM(PB_VIAJE_MUESTREO_TEST[NRO_MUESTREOS_ESPECIE]) , 
			    FILTER(PB_VIAJE_MUESTREO_TEST , PB_VIAJE_MUESTREO_TEST[CODIGO_ACTIVIDAD] IN {1 , 2  , 3 }) ,
			    PB_VIAJE_MUESTREO_TEST[LUGAR_MUESTREO] = "EMBARCADO" 
			
			)
			
			```
		formatString: 0
		lineageTag: 4a624384-a1f9-438b-bb30-7ea443363625

