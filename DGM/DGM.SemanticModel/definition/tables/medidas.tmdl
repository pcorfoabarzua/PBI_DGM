	measure 'Req Viajes (Pesqueria) V2' = ```
			
			
			VAR LugarNorm =
			    LOWER(
			        TRIM(
			            SELECTEDVALUE(
			                PB_VIAJE_MUESTREO_TEST[LUGAR_MUESTREO],
			                "embarcado"
			            )
			        )
			    )
			
			-- ✅ Evalúa si existen registros con región (por período, sin sesgos)
			VAR TieneRegion =
			    CALCULATE(
			        COUNTROWS('PB_REQ_VIAJES'),
			        NOT ISBLANK('PB_REQ_VIAJES'[COD_REGION]),
			
			        TREATAS(
			            VALUES('Date'[PERIODOMES]),
			            'PB_REQ_VIAJES'[PERIODOMES]
			        ),
			
			        REMOVEFILTERS('Dimension REGION'),
			        REMOVEFILTERS('Dimension FLOTA')
			    ) > 0
			
			-- ✅ EMBARCADO
			VAR ReqViajes_Emb =
			    IF(
			        TieneRegion,
			
			        -- ✅ CASO MIXTO O CON REGIÓN
			        CALCULATE(
			            SUM('PB_REQ_VIAJES'[TOT_VIAJE_EMB]),
			            TREATAS(
			                VALUES('Date'[PERIODOMES]),
			                'PB_REQ_VIAJES'[PERIODOMES]
			            ),
			
			            REMOVEFILTERS('Dimension FLOTA'),
			
			            -- 🔹 Parte 1: CON región (filtrado)
			            FILTER(
			                'PB_REQ_VIAJES',
			                NOT ISBLANK('PB_REQ_VIAJES'[COD_REGION])
			            ),
			
			            TREATAS(
			                VALUES('Dimension REGION'[COD_REGION]),
			                'PB_REQ_VIAJES'[COD_REGION]
			            )
			        )
			        +
			
			        -- 🔹 Parte 2: SIN región (siempre incluido)
			        CALCULATE(
			            SUM('PB_REQ_VIAJES'[TOT_VIAJE_EMB]),
			            TREATAS(
			                VALUES('Date'[PERIODOMES]),
			                'PB_REQ_VIAJES'[PERIODOMES]
			            ),
			
			            REMOVEFILTERS('Dimension REGION'),
			
			            FILTER(
			                'PB_REQ_VIAJES',
			                ISBLANK('PB_REQ_VIAJES'[COD_REGION])
			            )
			        ),
			
			        -- ✅ CASO SIN REGIÓN
			        CALCULATE(
			            SUM('PB_REQ_VIAJES'[TOT_VIAJE_EMB]),
			            TREATAS(
			                VALUES('Date'[PERIODOMES]),
			                'PB_REQ_VIAJES'[PERIODOMES]
			            ),
			
			            REMOVEFILTERS('Dimension REGION'),
			            REMOVEFILTERS('Dimension FLOTA')
			        )
			    )
			
			-- ✅ TIERRA
			VAR ReqViajes_Tie =
			    IF(
			        TieneRegion,
			
			        CALCULATE(
			            SUM('PB_REQ_VIAJES'[TOT_VIAJE_ENC]),
			            TREATAS(
			                VALUES('Date'[PERIODOMES]),
			                'PB_REQ_VIAJES'[PERIODOMES]
			            ),
			
			            REMOVEFILTERS('Dimension FLOTA'),
			
			            FILTER(
			                'PB_REQ_VIAJES',
			                NOT ISBLANK('PB_REQ_VIAJES'[COD_REGION])
			            ),
			
			            TREATAS(
			                VALUES('Dimension REGION'[COD_REGION]),
			                'PB_REQ_VIAJES'[COD_REGION]
			            )
			        )
			        +
			
			        CALCULATE(
			            SUM('PB_REQ_VIAJES'[TOT_VIAJE_ENC]),
			            TREATAS(
			                VALUES('Date'[PERIODOMES]),
			                'PB_REQ_VIAJES'[PERIODOMES]
			            ),
			
			            REMOVEFILTERS('Dimension REGION'),
			            REMOVEFILTERS('Dimension FLOTA'),
			
			            FILTER(
			                'PB_REQ_VIAJES',
			                ISBLANK('PB_REQ_VIAJES'[COD_REGION])
			            )
			        ),
			
			        CALCULATE(
			            SUM('PB_REQ_VIAJES'[TOT_VIAJE_ENC]),
			            TREATAS(
			                VALUES('Date'[PERIODOMES]),
			                'PB_REQ_VIAJES'[PERIODOMES]
			            ),
			
			            REMOVEFILTERS('Dimension REGION'),
			            REMOVEFILTERS('Dimension FLOTA')
			        )
			    )
			
			RETURN
			SWITCH(
			    TRUE(),
			    LugarNorm = "embarcado", ReqViajes_Emb,
