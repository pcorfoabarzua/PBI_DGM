	measure 'Estrellas Cumplimiento Viajes' = ```
			
			VAR Cumplimiento =
			    [% Cumplimiento General Viajes]
			RETURN
			SWITCH (
			    TRUE(),
			    ISBLANK ( Cumplimiento ), "",
			    Cumplimiento <= 0.30, "⭐",
			    Cumplimiento <= 0.70, "⭐⭐",
			    "⭐⭐⭐"
			)
			
			```
		lineageTag: 59192360-195a-467c-a914-bed849a3d28e

