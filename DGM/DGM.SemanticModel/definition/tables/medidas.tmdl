			)
			 
			 
			VAR Resultado =
			    SWITCH(
			        TRUE(),
			        LugarNorm = "embarcado", Req_long_emb,
			        LugarNorm = "tierra" || LugarNorm = "encuesta en tierra", Req_long_tierra,
			        -- default si el LUGAR no está definido
