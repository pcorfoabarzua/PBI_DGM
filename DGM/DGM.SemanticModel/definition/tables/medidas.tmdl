			        TREATAS(
			            VALUES('Date'[PERIODOMES]),
			            'PB_REQ_MUESTREO'[PERIODOMES]
			        )
			    ) , FILTER(PB_REQ_MUESTREO , PB_REQ_MUESTREO[LUGAR_MUESTREO] = "EMBARCADO")
			)
			 
			 
			VAR Resultado =
			    SWITCH(
			        TRUE(),
			        LugarNorm = "embarcado", Req_oto_emb,
			        LugarNorm = "tierra" || LugarNorm = "encuesta en tierra", Req_oto_tierra,
			        -- default si el LUGAR no está definido
			        Req_oto_tierra + Req_oto_emb
			    )
			RETURN
			Resultado
			
			
			```
		formatString: 0
		lineageTag: 7e7f74f9-b8f4-4f20-a143-7f514f229967

	measure 'Req Longitud' = ```
			
			
			 VAR LugarNorm =
			    LOWER(
			        TRIM(
			            SELECTEDVALUE( PB_VIAJE_MUESTREO_TEST[LUGAR_MUESTREO], "embarcado" )
			        )
