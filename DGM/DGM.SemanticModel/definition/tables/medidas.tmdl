	measure 'Req Viajes' = ```
			
			VAR LugarNorm =
			    LOWER(
			        TRIM(
			            SELECTEDVALUE( PB_VIAJE_MUESTREO_TEST[LUGAR_MUESTREO], "embarcado" )
			        )
			    )
			
			VAR ReqViajes_Embarcados =
			    CALCULATE(
			        SUM( 'PB_REQ_VIAJES'[TOT_VIAJE_EMB] ),
			        TREATAS( VALUES( 'Date'[PERIODOMES] ), 'PB_REQ_VIAJES'[PERIODOMES] )
			    )
			
			VAR ReqViajes_Tierra =
			    CALCULATE(
			        SUM( 'PB_REQ_VIAJES'[TOT_VIAJE_ENC] ),
			        TREATAS( VALUES( 'Date'[PERIODOMES] ), 'PB_REQ_VIAJES'[PERIODOMES] ))
			
			VAR Resultado =
			    SWITCH(
			        TRUE(),
			        LugarNorm = "embarcado", ReqViajes_Embarcados,
			        LugarNorm = "tierra" || LugarNorm = "encuesta en tierra", ReqViajes_Tierra,
			        -- default si el LUGAR no está definido
			        ReqViajes_Embarcados
			    )
			RETURN
			Resultado
			
			```
		formatString: 0
		lineageTag: 5ec2af2e-9fb9-42a2-9c85-cc64657d2867

	measure 'Cumplimiento viaje' = ```
			
			VAR Viajes =
			    [Viajes totales]
			
			VAR Req =
			    [Req Viajes]
			
			RETURN
			IF (
			    NOT [Req Viajes Existe],
			    BLANK (),
			    DIVIDE ( Viajes, Req )
			)
			
			
			
			```
		lineageTag: c85b6c01-2f3b-49c0-87af-0e839f24da1e

	measure 'Nombre especie (medida)' = ```
			
			VAR CodigoElegido =
			    SWITCH (
			        TRUE(),
			        SELECTEDVALUE ( PB_VIAJE_MUESTREO_TEST[CODIGO_ACTIVIDAD] ) = 40,
			            SELECTEDVALUE ( PB_VIAJE_MUESTREO_TEST[COD_ESPECIE_OBJETIVO] ),
			        -- caso contrario
			            SELECTEDVALUE ( PB_VIAJE_MUESTREO_TEST[COD_ESPECIE] )
			    )
			RETURN
			    LOOKUPVALUE (
			        'Dimension MAESTRO ESPECIE'[NOMBRE_ESPECIE],         -- columna a devolver
			        'Dimension MAESTRO ESPECIE'[COD_ESPECIE], CodigoElegido   -- búsqueda por código
			    )
			
			
			
			```
		lineageTag: 8fed20cf-3119-44c6-8031-a8f906bbe7ad

