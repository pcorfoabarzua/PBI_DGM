	measure 'Titulo Req Viajes' = ```
			
			VAR ProyectoCod =
			    SELECTEDVALUE (
			        PB_VIAJE_MUESTREO_TEST[PROYECTO],
			        "MULTI"
			    )
			
			VAR ProyectoNombre =
			    SWITCH (
			        ProyectoCod,
			        "PCS", "PCS",
			        "PN",  "PZN",
			        "DAP",  "DAP",
			        "C",  "CRU DEM",
			        "CB" , "CRU BEN" ,
			        "DES" , "DES DEM" ,
			        "DES_CER" , "DES PEL" ,
			        "B" , "BENT" ,
			        "JIBIA" , "JIBIA" ,
			        "MULTI", "Múltiples proyectos",
			        ProyectoCod
			    )
			
			VAR Cumplimiento = [% Cumplimiento General Viajes]
			
			VAR CumplimientoTxt =
			    FORMAT ( Cumplimiento, "0.0%" )
			
			VAR Estrellas =
