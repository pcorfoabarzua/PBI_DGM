table 'Dimension PROYECTO'
	lineageTag: 84559002-0b56-40f0-9813-4ca2a87d6e8f

	column COD_PROYECTO
		lineageTag: 6a0429d0-b571-4753-b110-f828b789acc9
		summarizeBy: none
		isNameInferred
		sourceColumn: [COD_PROYECTO]

		annotation SummarizationSetBy = Automatic

	column NOMBRE_PROYECTO
		lineageTag: 5deaf83c-0b3c-4866-8069-9fc0ccaca6c3
		summarizeBy: none
		isNameInferred
		sourceColumn: [NOMBRE_PROYECTO]

		annotation SummarizationSetBy = Automatic

	column SIGLA_PROYECTO =
			
			SWITCH(
			    TRUE(),
			    'Dimension PROYECTO'[COD_PROYECTO] = "B", "BENT",
			    'Dimension PROYECTO'[COD_PROYECTO] = "CB", "CRU BENT",
			    'Dimension PROYECTO'[COD_PROYECTO] = "C", "CRU DEM",
			    'Dimension PROYECTO'[COD_PROYECTO] = "DAP", "DAP",
			    'Dimension PROYECTO'[COD_PROYECTO] = "DES", "DES DEM",
			    'Dimension PROYECTO'[COD_PROYECTO] = "DES_CER", "DES PEL",
			    'Dimension PROYECTO'[COD_PROYECTO] = "JIBIA", "JIBIA",
			    'Dimension PROYECTO'[COD_PROYECTO] = "PCS", "PCS",
			    'Dimension PROYECTO'[COD_PROYECTO] = "PN", "PZN",
			    'Dimension PROYECTO'[COD_PROYECTO] = "SRAM", "SRAM",
			    BLANK()
			)
		lineageTag: 6daafd07-d4cf-49b1-80d7-db0657c6bd19
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'Dimension PROYECTO' = calculated
		mode: import
		source =
				
				VAR ProyViaje =
				    SELECTCOLUMNS (
				        'PB_VIAJE_MUESTREO_TEST',
				        "COD_PROYECTO", UPPER ( TRIM ( 'PB_VIAJE_MUESTREO_TEST'[PROYECTO] ) ),
				        "NOMBRE_PROYECTO", UPPER ( TRIM ( 'PB_VIAJE_MUESTREO_TEST'[PROYECTO] ) )
				    )
				VAR ProyReq =
				    SELECTCOLUMNS (
				        'PB_REQ_MUESTREO',
				        "COD_PROYECTO", UPPER ( TRIM ( 'PB_REQ_MUESTREO'[COD_PROYECTO] ) ),
				        "NOMBRE_PROYECTO", UPPER ( TRIM ( 'PB_REQ_MUESTREO'[COD_PROYECTO] ) )
				    )
				RETURN
				    DISTINCT ( UNION ( ProyViaje, ProyReq ) )

	annotation PBI_Id = ac503af69d8f48179149de69dc729615

